{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-dictation-iphone-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dictate.natemunk.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "MAC_ORIGIN_URL": "https://dictate-origin.natemunk.com"
  },
  "ai": {
    "binding": "AI"
  },
  // Static assets are the PWA shell only. run_worker_first keeps every request under
  // Worker control so /v1/* can never be answered from the asset store.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "upload_source_maps": true
}
